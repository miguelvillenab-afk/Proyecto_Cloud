# .env.prod.example — copiar a .env.prod en cada MV (NO commitear el real)
# cp .env.prod.example .env.prod
# En app-1/app-2 y db-1 el contenido es el mismo, solo cambia DB_HOST_PRIVADO si cambia la IP.

# --- IP privada de la MV-DB (3ra MV). Ejemplo VPC 10.0.x.x. Ajustar tras crear EC2 ---
DB_HOST_PRIVADO=10.0.3.10

# --- MS1 Postgres (misma clave en app y db) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=cambia_en_prod
POSTGRES_DB=users_db
JWT_SECRET_KEY=cambia_esta_clave_larga_y_aleatoria_en_prod
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# --- MS2 MySQL ---
DB_NAME=properties_db
DB_USER=properties_user
DB_PASSWORD=cambia_en_prod
MYSQL_ROOT_PASSWORD=cambia_root_en_prod

# --- MS5 Analytics (contrato para tu compañero, usa IAM Role en EC2, no keys fijas) ---
AWS_REGION=us-east-1
ATHENA_DB=analytics_db
ATHENA_OUTPUT_S3=s3://proyecto-cloud-athena-results-xxx/
PORT=8003
