# reservations_microservice/.env.example — Plantilla de variables de entorno
# Copiar a .env y ajustar valores: cp .env.example .env

# Puerto en el que se ejecuta la API de Reservas
PORT=3000

# Cadena de conexión a MongoDB
# "db_reservations" es el nombre del servicio en docker-compose (dentro de la red Docker).
MONGODB_URI=mongodb://db_reservations:27017/reservations_db

# URLs de los microservicios externos para validar huésped y propiedad antes de crear una reserva
# OPCIÓN A — microservicios en compose separado / host (recomendado si cada MS tiene su propio docker-compose.yml):
USER_SERVICE_URL=http://host.docker.internal:8000
PROPERTY_SERVICE_URL=http://host.docker.internal:8081

# OPCIÓN B — si unes los 3 compose en una misma red Docker externa (descomentar y usar nombres de servicio):
# USER_SERVICE_URL=http://api_users:8000
# PROPERTY_SERVICE_URL=http://api_properties:8081
