# Puerto en el que se ejecuta la API de Reservas
PORT=3000

# Cadena de conexión a MongoDB.
# "db_reservations" es el nombre del servicio en docker-compose (dentro de la red Docker).
MONGODB_URI=mongodb://db_reservations:27017/reservations_db

# URLs de los microservicios externos que este servicio consume para validar
# al huésped y a la propiedad antes de crear una reserva.
# Dentro de docker-compose usar el nombre del servicio/contenedor como host.
USER_SERVICE_URL=http://api_users:8000
PROPERTY_SERVICE_URL=http://api_properties:8080
