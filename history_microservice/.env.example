# history_microservice/.env.example — Plantilla de variables de entorno (SIN BD propia)
# Copiar a .env y ajustar valores: cp .env.example .env

# Puerto en el que se ejecuta la API de Historial de Viajes
PORT=8082

# URLs de los microservicios externos (mismo patrón que reservations_microservice/.env.example)
# OPCIÓN A — cada MS con su propio docker-compose (recomendado):
USER_SERVICE_URL=http://host.docker.internal:8000
RESERVATIONS_SERVICE_URL=http://host.docker.internal:3000
PROPERTY_SERVICE_URL=http://host.docker.internal:8081

# OPCIÓN B — si unes los compose en una misma red Docker (descomentar y usar nombres de servicio):
# USER_SERVICE_URL=http://api_users:8000
# RESERVATIONS_SERVICE_URL=http://api_reservations:3000
# PROPERTY_SERVICE_URL=http://api_properties:8081

# Timeout por petición a MS1/MS2/MS3 (ms)
REQUEST_TIMEOUT_MS=5000
