# properties_microservice/.env.example — Plantilla de variables de entorno
# Copiar a .env y ajustar valores: cp .env.example .env

# --- Base de Datos MySQL ---
DB_HOST=db_properties
DB_PORT=3306
DB_NAME=properties_db
DB_USER=properties_user
DB_PASSWORD=properties_password
MYSQL_ROOT_PASSWORD=rootpassword

# --- API ---
SERVER_PORT=8081
JPA_DDL_AUTO=update
